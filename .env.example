# Painel Execução — Configuração de Exemplo
# Copie este arquivo para .env.local e preencha com seus valores
# .env.local é ignorado pelo git (veja .gitignore)

# === Gemini IA (Opcional) ===

# Chave da API Gemini (obtenha em: https://aistudio.google.com/app/apikeys)
# Deixe vazio para desabilitar explicações por IA
GEMINI_API_KEY=

# Modelo Gemini a usar (exemplo: gemini-pro, gemini-2.0-flash)
# Confirme disponibilidade em sua conta antes de usar
GEMINI_MODEL=

# Habilitar explicações por IA? (true/false)
# Padrão: false (desativado)
GEMINI_ENABLED=false

# === Collector (Backend) ===

# Projeto ativo para captura (nome do projeto Claude Code)
# Padrão: default
CLAUDE_CODE_PROJECT=painel-execucao

# Diretório de armazenamento (será criado em ~/.painel-execucao)
# Padrão: ~/.painel-execucao
# PAINEL_STORAGE_DIR=

# Tamanho máximo de evento em bytes
# Padrão: 1MB (1048576)
# PAINEL_MAX_EVENT_SIZE=1048576

# === Desenvolvimento ===

# Debug mode (verbose logs)
# DEBUG=painel-execucao:*
