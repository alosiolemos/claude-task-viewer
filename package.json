{
  "name": "painel-execucao",
  "version": "0.3.1",
  "description": "Painel local em VS Code para acompanhar e auditar execução de trabalhos do Claude Code, semelhante ao n8n.",
  "author": "Aloisio Lemos <aloisio.lemosrn@gmail.com>",
  "license": "MIT",
  "type": "module",
  "main": "collector.js",
  "scripts": {
    "test": "node --test tests/converter.test.cjs",
    "collect:demo": "bash test-collector.sh",
    "collect:read": "node reader.js painel-execucao",
    "ext:dev": "cd extension && npm run watch",
    "ext:build": "node scripts/build.mjs",
    "web:dev": "cd webview && npm start",
    "web:build": "cd webview && npm run build",
    "build": "node scripts/build.mjs",
    "package": "node scripts/package.mjs"
  },
  "keywords": [
    "claude-code",
    "execution-tracking",
    "audit",
    "workflow",
    "visualization",
    "vscode",
    "extension"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "workspaces": [
    "extension",
    "webview"
  ],
  "devDependencies": {
    "archiver": "^8.0.0"
  }
}
