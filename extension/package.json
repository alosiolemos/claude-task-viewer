{
  "name": "painel-execucao",
  "displayName": "Visualização Modular de Execução das Tarefas do Claude",
  "description": "Acompanhe em cartões conectados o que o Claude Code faz em cada tarefa, lendo as transcrições locais. Inspirado em visualizações de workflow como as do n8n; sem vínculo com o n8n.",
  "version": "0.8.3",
  "publisher": "aloisiolemos",
  "author": "Aloisio Lemos",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/alosiolemos/claude-task-viewer"
  },
  "type": "module",
  "main": "dist/extension.cjs",
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=18.0.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "claude-code",
    "execução",
    "auditoria",
    "workflow",
    "transcrição",
    "visualização"
  ],
  "activationEvents": [
    "onCommand:painel-execucao.open",
    "onCommand:painel-execucao.chooseTranscript"
  ],
  "contributes": {
    "commands": [
      {
        "command": "painel-execucao.open",
        "title": "Abrir Visualização de Execução do Claude",
        "category": "Visualização de Execução"
      },
      {
        "command": "painel-execucao.chooseTranscript",
        "title": "Escolher sessão do Claude",
        "category": "Visualização de Execução"
      }
    ],
    "configuration": [
      {
        "title": "Visualização de Execução do Claude",
        "properties": {
          "painel-execucao.transcriptsDir": {
            "type": "string",
            "default": "",
            "description": "Pasta com as transcrições (.jsonl) do Claude Code para este projeto. Vazio = detectar em ~/.claude/projects (ou CLAUDE_CONFIG_DIR)."
          },
          "painel-execucao.refreshInterval": {
            "type": "number",
            "default": 1500,
            "minimum": 500,
            "description": "Intervalo, em milissegundos, para verificar novas linhas na transcrição."
          }
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "node ../scripts/build.mjs",
    "build": "node ../scripts/build.mjs",
    "package": "node ../scripts/package.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.32.0",
    "esbuild": "^0.28.2"
  }
}
